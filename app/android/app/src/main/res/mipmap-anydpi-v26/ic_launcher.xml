<?xml version="1.0" encoding="utf-8"?>
<!-- The foreground and monochrome layers are bitmaps rather than vectors: the
     logo is supplied as artwork, not as paths, so tracing it would only ever
     approximate it. They're generated from that artwork by
     tool/generate_app_icons.py. The background stays a vector — it's a flat
     radial gradient and gains nothing from being a bitmap. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
