# Copy to .env and fill in. Used by docker-compose.

# Postgres (used by the db service and the API's DATABASE_URL).
POSTGRES_USER=musillow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=musillow

# Secrets — generate long random values, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-jwt
SECRET_KEY=change-me-encryption

# The API is reached over your NetBird overlay. No public ingress/TLS needed;
# NetBird encrypts transport. Point the app at http://<netbird-peer>:8080.

# slskd (Soulseek daemon) — fulfils download requests. SLSKD_API_KEY is a
# readwrite API key from slskd's web.authentication.api_keys.
SLSKD_URL=http://host.docker.internal:5030
SLSKD_API_KEY=change-me-slskd-key
